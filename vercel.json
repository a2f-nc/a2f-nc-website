{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/unc-acts2fellowship",
      "destination": "/unc",
      "permanent": true
    },
    {
      "source": "/a2f-nc-state",
      "destination": "/nc-state",
      "permanent": true
    },
    {
      "source": "/about-our-story",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/ministries",
      "destination": "/other-ministries",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(img|vid|people|sym|brand|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
